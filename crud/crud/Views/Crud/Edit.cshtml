
@model crud.Models.student
<form method="post">
    <table>

        <tr>
            <th>ID</th>
            <th><input type="text"  value="@Model.id" disabled class="form-control" /></th>
        </tr> 
        <tr>
            <th>Name</th>
            <th><input type="text" placeholder="Name" value="@Model.name" name="name" class="form-control" /></th>
        </tr>
        <tr>

            <th><input type="submit" value="Edit" class="btn btn-outline-primary btn-lg" /></th>
        </tr>
    </table>
</form>