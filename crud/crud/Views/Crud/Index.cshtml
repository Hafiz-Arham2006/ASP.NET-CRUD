@model IEnumerable<crud.Models.student>

<h1 class="text-center">CRUD Application usin ASP.NET MVC</h1>
<a href="@Url.Action("Create","Crud")" class="btn btn-primary btn-lg">Add+</a>
<table class="table table-bordered table-striped text-center">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th colspan="2">Actions</th>
    </tr>
    @foreach(var data in Model)
            {
                    <tr>
                        <td>@data.id</td>
                        <td>@data.name</td>
                           <td><a href="@Url.Action("Delete","Crud",new {id=data.id})" class="btn btn-danger">Delete</a></td> 
                           <td><a href="@Url.Action("Edit","Crud",new {id=data.id })" class="btn btn-warning">Edit</a></td> 
                    </tr>
                        
            }
</table>